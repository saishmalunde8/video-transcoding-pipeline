# Copy this file to .env and adjust as needed.
# .env is in .gitignore and is never committed -- this file is the
# documentation of what settings exist and what a safe default looks like.

PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# After SIGTERM/SIGINT, how long (ms) to let in-flight requests finish before
# forcing exit. Keep it BELOW your platform's stop grace period (Docker's default
# is 10 seconds, after which it sends SIGKILL).
SHUTDOWN_TIMEOUT_MS=8000

# PostgreSQL connection string. This is a SECRET (it contains the password):
# put the real value only in .env, never in this file, never in a log.
# Shape: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# If the password has special characters (@ : / ? #) they must be %-encoded.
DATABASE_URL=postgres://transcoder_app:CHANGE_ME@127.0.0.1:5432/transcoder
