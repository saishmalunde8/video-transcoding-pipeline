{
  "name": "video-transcoding-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted video transcoding pipeline with an event-loop observability lab",
  "type": "module",
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch --preserveWatchOutput",
    "start": "node dist/server.js",
    "start:watch": "node --watch dist/server.js",
    "smoke": "bash scripts/smoke.sh",
    "pg": "bash scripts/pg.sh",
    "lab:cli": "node dist/lab/cli.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5"
  }
}
